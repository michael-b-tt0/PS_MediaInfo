<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>GetMediaInfo.VideoMediaInfoResult</Name>
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.VideoMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Frame rate</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resolution</Label></TableColumnHeader>
          <TableColumnHeader><Label>Duration</Label></TableColumnHeader>
          <TableColumnHeader><Label>Video</Label></TableColumnHeader>
          <TableColumnHeader><Label>Audio</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.FrameRate) {
                    '{0:0.###} fps' -f $_.FrameRate
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>Resolution</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.Duration) {
                    $_.Duration.ToString('hh\:mm\:ss\.fff')
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>VideoCodec</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AudioCodec</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>GetMediaInfo.AudioMediaInfoResult</Name>
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.AudioMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
          <TableColumnHeader><Label>Duration</Label></TableColumnHeader>
          <TableColumnHeader><Label>Audio</Label></TableColumnHeader>
          <TableColumnHeader><Label>Artist</Label></TableColumnHeader>
          <TableColumnHeader><Label>Album</Label></TableColumnHeader>
          <TableColumnHeader><Label>Track</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ContainerFormat</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.Duration) {
                    $_.Duration.ToString('hh\:mm\:ss\.fff')
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>AudioCodec</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Artist</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Album</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.TrackNumber) {
                    if ($null -ne $_.TrackCount) {
                      '{0}/{1}' -f $_.TrackNumber, $_.TrackCount
                    } else {
                      $_.TrackNumber
                    }
                  }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>GetMediaInfo.ImageMediaInfoResult</Name>
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.ImageMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resolution</Label></TableColumnHeader>
          <TableColumnHeader><Label>BitDepth</Label></TableColumnHeader>
          <TableColumnHeader><Label>SizeMiB</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ImageFormat</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Resolution</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>BitDepth</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SizeMiB</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>GetMediaInfo.UnknownMediaInfoResult</Name>
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.UnknownMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
          <TableColumnHeader><Label>SizeMiB</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ContainerFormat</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SizeMiB</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
